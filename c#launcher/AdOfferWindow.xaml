<Window x:Class="CraftunityLauncher.AdOfferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Предложение" Width="620" Height="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}">
    <Border Style="{StaticResource Card}" Margin="14">
        <StackPanel>
            <TextBlock x:Name="InfoText" Style="{StaticResource Muted}" FontSize="13"
                       TextWrapping="Wrap" Margin="0,0,0,18"/>
            <TextBlock Text="Сколько беру/продаю" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
            <TextBox x:Name="CountBox" Height="36" FontSize="14" Margin="0,0,0,14"/>
            <TextBlock Text="Сколько плачу/прошу" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
            <TextBox x:Name="PriceBox" Height="36" FontSize="14"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Отмена" Click="OnCancel" Margin="0,0,8,0"/>
                <Button Content="Отправить" Style="{StaticResource PrimaryButton}" Click="OnSend"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
