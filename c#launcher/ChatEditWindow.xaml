<Window x:Class="CraftunityLauncher.ChatEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Изменить сообщение" Width="460" Height="200"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}">
    <Border Style="{StaticResource Card}" Margin="14">
        <StackPanel>
            <TextBlock Text="Новый текст сообщения" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
            <TextBox x:Name="Input" MaxLength="500" Height="58" AcceptsReturn="False"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Отмена" Click="OnCancel" Margin="0,0,8,0"/>
                <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Click="OnSave"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
