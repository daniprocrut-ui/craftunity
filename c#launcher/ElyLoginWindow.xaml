<Window x:Class="CraftunityLauncher.ElyLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход ely.by" Height="240" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}">
    <Border Style="{StaticResource Card}" Margin="16">
        <StackPanel>
            <TextBlock Text="Аккаунт ely.by" Style="{StaticResource H2}" Margin="0,0,0,12"/>
            <TextBlock Text="Логин" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
            <TextBox x:Name="LoginBox" Margin="0,0,0,10"/>
            <TextBlock Text="Пароль" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordBox" Margin="0,0,0,14"
                         Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}"
                         BorderThickness="1" Padding="10,8"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Click="OnCancelClick" Margin="0,0,8,0"/>
                <Button Content="Войти" Style="{StaticResource PrimaryButton}" Click="OnOkClick"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
